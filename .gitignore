# ─── Textbooks (large, copyrighted — never commit PDFs) ─────────────────────
ingestion/test-books/*
!ingestion/test-books/.gitkeep

# ─── PDF safety net ──────────────────────────────────────────────────────────
*.pdf

# ─── Intermediate Ingestion Outputs (regenerable via run_pipeline.py) ────────
ingestion/output/
ingestion/analysis-result/
*.jsonl
ui/static/figures_cache/*
!ui/static/figures_cache/*.jpg

# ─── Local Databases ─────────────────────────────────────────────────────────
*.db
!textbook_rag.db
*.db-journal
*.db-wal
*.db-shm

# ─── Secrets and Environment Config ─────────────────────────────────────────
.env
!.env.example

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
*.pyo

# ─── Editors and OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ─── Docker ──────────────────────────────────────────────────────────────────
# Keep docker-compose.yml committed; ignore runtime volumes
docker-data/
