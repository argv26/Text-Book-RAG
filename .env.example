# Environment Configuration for Text-Book-RAG
# Copy this file to .env and fill in your values

# ─── LLM Configuration ──────────────────────────────────────────────────────
# Set at least one of these to enable live LLM mode.
# Without API keys, the app runs fully offline using the Smart Retrieval Synthesizer.

# Google Gemini (recommended — get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (optional alternative)
OPENAI_API_KEY=

# Override the default LLM model (optional)
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o

# ─── Database Configuration ──────────────────────────────────────────────────
# Omit DATABASE_URL to use the local SQLite FTS5 database (zero setup).
# Set DATABASE_URL to use PostgreSQL + pgvector for production hybrid search.

# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/textbook_rag

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=8000

